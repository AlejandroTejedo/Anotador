    },
    "%@ está redactando las notas…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is writing the notes…"
          }
        }
      }
    },
    "%@ ha limitado las peticiones o no te queda saldo (429). Espera un poco o revisa tu cuenta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is rate-limiting requests or your credit ran out (429). Wait a moment or check your account."
          }
        }
      }
    },
    "%@ no encuentra el modelo “%@”. Elige otro en Ajustes → Modelo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can't find the model “%2$@”. Pick another in Settings → Model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ no encuentra el modelo “%2$@”. Elige otro en Ajustes → Modelo."
          }
        }
      }
    },
    "%@ no pudo redactar las notas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn't write the notes."
          }
        }
      }
    },
    "%@ rechazó la API key (%lld). Revísala en Ajustes → Modelo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rejected the API key (%2$lld). Check it in Settings → Model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ rechazó la API key (%2$lld). Revísala en Ajustes → Modelo."
          }
        }
      }
    },
    "%@ rechazó la petición: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ refused the request: %2$@"
          }
