        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ rechazó la petición: %2$@"
          }
        }
      }
    },
    "%@ tardó demasiado en responder. Pulsa Reintentar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ took too long to respond. Click Retry."
          }
        }
      }
    },
