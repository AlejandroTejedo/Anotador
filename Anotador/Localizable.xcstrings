    "%@ devolvió algo que no es JSON.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned something that isn't JSON."
          }
        }
      }
    },
    "%@ devolvió un error %lld%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ returned error %2$lld%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ devolvió un error %2$lld%3$@"
          }
        }
      }
    },
    "%@ devolvió una respuesta sin contenido.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned an empty response."
          }
        }
      }
    },
    "%@ devolvió una respuesta vacía.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned an empty response."
          }
        }
      }
    },
    "%@ devolvió unas notas vacías.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned empty notes."
          }
        }
